NEXT_PUBLIC_SANITY_PROJECT_ID=svrzh6fe
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only for a local design preview before importing content.
DEMO_MODE=false
# Server-only Viewer token for draft preview (optional).
SANITY_API_READ_TOKEN=
# Server-only Editor token, used only by npm run seed. Remove after import.
SANITY_API_WRITE_TOKEN=
# Optional server-side email delivery. Recipient is edited in Sanity > Contato.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
